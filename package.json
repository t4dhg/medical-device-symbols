{
  "name": "medical-device-symbols",
  "version": "2.2.0",
  "description": "React components for ISO 15223-1:2021 medical device symbols: EU MDR/IVDR, FDA, and global labeling compliance. TypeScript, themeable, zero runtime dependencies.",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-index.mjs",
    "generate:check": "node scripts/generate-index.mjs --check",
    "clean": "node scripts/build.mjs --clean-only",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:check && node scripts/build.mjs",
    "test:unit": "node --test test/*.test.cjs",
    "test": "npm run build && npm run test:unit"
  },
  "keywords": [
    "medical-device",
    "symbols",
    "iso-15223-1",
    "mdr",
    "ivdr",
    "fda",
    "regulatory",
    "compliance",
    "icons",
    "svg",
    "international",
    "global",
    "medical",
    "device",
    "labeling",
    "healthcare",
    "react",
    "react-component",
    "typescript"
  ],
  "author": "Taig Mac Carthy",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4dhg/medical-device-symbols.git"
  },
  "bugs": {
    "url": "https://github.com/t4dhg/medical-device-symbols/issues"
  },
  "homepage": "https://github.com/t4dhg/medical-device-symbols#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
